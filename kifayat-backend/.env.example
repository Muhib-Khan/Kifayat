# Kifayat Backend — Required Environment Variables
# Copy this file to .env and fill in your values.
# Sensitive values should be stored in Replit Secrets, not committed here.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<long-random-string>
JWT_EXPIRE=30d

# ── Firebase (Google OAuth) ────────────────────────────────────────────────────
# Option A: path to a service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: full JSON contents as a single-line string (for Replit Secrets)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=<your-firebase-project-id>

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USER=<gmail-address>
EMAIL_PASS=<gmail-app-password>   # Generate at myaccount.google.com/apppasswords

RESEND_API_KEY=re_<your-resend-key>
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Public URL used in emailed links. Set this to the URL customers can open.
PUBLIC_APP_URL=https://your-frontend.example.com
# Backwards-compatible alias; PUBLIC_APP_URL takes precedence.
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
SITE_URL=http://localhost:5173
SITE_NAME=Kifayat

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ── HHC Dropshipping API ──────────────────────────────────────────────────────
HHC_API_URL=https://member.hhcdropshipping.com/api
HHC_REFERER=https://member.hhcdropshipping.com/
HHC_ORIGIN=https://member.hhcdropshipping.com

# ── AI product copy and categorization ───────────────────────────────────────
GROQ_API_KEY=gsk_<your-groq-key>
