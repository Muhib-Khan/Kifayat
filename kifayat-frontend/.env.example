# Kifayat Frontend — safe template
# The real .env file stays local/ignored. Copy this file to .env.local and fill
# in the public Firebase web configuration values from your Firebase project.

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_API_URL=http://localhost:5000

# Leave empty for the same-origin Replit/Vite proxy.
VITE_API_URL=

# Optional map providers. The app falls back to OpenStreetMap when unset.
VITE_MAPBOX_TOKEN=
VITE_HERE_API_KEY=